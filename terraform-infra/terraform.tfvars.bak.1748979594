# Project Configuration
project_name = "devops"
environment  = "dev"
owner        = "DevOps-Engineer"

# AWS Configuration
aws_region         = "eu-central-1"
availability_zones = ["eu-central-1a", "eu-central-1b"]

# Deployment Control
deploy_database = true  # Set to true to deploy database instance
deploy_lambda   = true  # Set to true to deploy Lambda for database connectivity (requires deploy_database=true)

# Instance Configuration
instance_type  = "t3.medium"
key_pair_name  = ""  # Leave empty to auto-generate SSH key pair

# Network Configuration
vpc_cidr              = "10.0.0.0/16"
public_subnet_cidrs   = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs  = ["10.0.10.0/24", "10.0.20.0/24"]

# Storage Configuration
ebs_volume_size = 30
ebs_volume_type = "gp3"

# Monitoring Configuration
enable_detailed_monitoring = true

allowed_cidr_blocks = ["93.105.176.53/32"]  # Replace 93.105.176.53 with your actual IP
ssh_cidr_blocks     = ["93.105.176.53/32"]  # Replace 93.105.176.53 with your actual IP
